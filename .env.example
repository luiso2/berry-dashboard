# Berry Dashboard - Environment Variables

# Server Configuration
PORT=3001
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@host:port/database

# Required - for AI chat features
OPENAI_API_KEY=your_openai_api_key

# Required - for email notifications
RESEND_API_KEY=your_resend_api_key
FROM_EMAIL=Berry Bly <noreply@merktop.com>
NOTIFICATION_EMAIL=concierge@berrybly.com

# Required - for SMS notifications (Telnyx)
TELNYX_API_KEY=your_telnyx_api_key
TELNYX_PHONE_NUMBER=+1234567890
# Webhook signature verification (get from Telnyx Portal > Account Settings > Public Key)
TELNYX_PUBLIC_KEY=your_telnyx_public_key_base64

# Optional - for image uploads (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional - for web scraping (Bright Data)
BRIGHTDATA_API_KEY=your_brightdata_api_key

# PeptideConnect B2B marketplace
# openFDA / data.gov API key (drug shortages, recalls, labels)
OPENFDA_API_KEY=your_openfda_data_gov_key
# USDA NASS QuickStats API key (commodity pricing intel)
NASS_API_KEY=your_usda_nass_key
# Optional: override the OpenAI model used by the peptide agent (default gpt-4o-mini)
PEPTIDE_OPENAI_MODEL=gpt-4o-mini

# Security - API authentication for admin routes
API_KEY=your_secure_api_key

# CORS Origins (comma-separated)
CORS_ORIGIN=http://localhost:5173,https://berryblyproduction.com,https://berrydashboard.merktop.com
